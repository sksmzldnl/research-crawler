{
  "name": "zerowaste-listening-studio",
  "version": "0.12.4",
  "private": true,
  "description": "네이버·Reddit 원문과 댓글 수집 · 개별 MD/JSON 저장",
  "author": "ZeroWaste Listening Studio contributors",
  "license": "UNLICENSED",
  "type": "module",
  "main": "build/desktop/main.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others \"tsx server/index.ts\" \"vite --host 127.0.0.1\"",
    "desktop": "npm run build && node scripts/ensure-electron.mjs && electron .",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.node.json && tsc -p tsconfig.json && vite build && node scripts/postbuild.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:live": "tsx scripts/live-test.ts",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:linux": "npm run build && electron-builder --linux dir --publish never",
    "test:desktop": "node scripts/ensure-electron.mjs && node scripts/desktop-smoke.mjs"
  },
  "dependencies": {
    "iconv-lite": "^0.7.3",
    "jsdom": "^27.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "undici": "^7.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.0",
    "electron": "45.0.0",
    "electron-builder": "^26.0.12",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  },
  "build": {
    "appId": "org.zerowaste.listeningstudio",
    "productName": "ZeroWaste Listening Studio",
    "artifactName": "ZeroWaste-Listening-Studio-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "identity": "-",
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "dir"
      ],
      "category": "Education"
    }
  }
}
